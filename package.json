{
  "name": "bpmnforge",
  "version": "0.2.0",
  "type": "module",
  "description": "Agent-friendly offline BPMN and interactive HTML generator",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bpmnforge": "bin/bpmnforge.mjs"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "assets",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    "./build": "./dist/build.js",
    "./domain": "./dist/domain.js",
    "./validate": "./dist/validate.js",
    "./layout": "./dist/layout.js",
    "./bpmn": "./dist/bpmn.js",
    "./html": "./dist/html.js",
    "./schema": "./schema/bpmnforge.schema.json"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && npm run test:unit && npm run test:e2e && npm run test:package",
    "test:unit": "node --test tests/validation.test.ts tests/build.test.ts tests/layout.test.ts tests/phase3.profile.test.ts tests/semantics.test.ts tests/licenses.test.ts tests/readability.test.ts tests/readability-layout.test.ts tests/readability-routing.test.ts",
    "test:e2e": "node --test --test-concurrency=1 tests/*.e2e.test.ts",
    "test:package": "node --test tests/package.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "bpmn-moddle": "10.3.1",
    "bpmn-js": "18.31.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DatKorso/bpmnforge.git"
  },
  "homepage": "https://github.com/DatKorso/bpmnforge#readme",
  "bugs": {
    "url": "https://github.com/DatKorso/bpmnforge/issues"
  },
  "keywords": [
    "bpmn",
    "bpmn2",
    "cli",
    "offline",
    "ai-agents",
    "process-visualization"
  ]
}
